<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:CurveDep.ViewModels"
             xmlns:behaviors="clr-namespace:CurveDep.Behaviors"
             xmlns:controls="clr-namespace:CurveDep.Controls"
             xmlns:local="clr-namespace:CurveDep"
             x:Class="CurveDep.MainPage">

    <ContentPage.BindingContext>
        <viewmodels:MVM />
    </ContentPage.BindingContext>

    <ScrollView>
        <Grid RowDefinitions="45,35,20,Auto,Auto,Auto,Auto,1,30,30,70,30,50"
              ColumnDefinitions="160,70,70,800"
              RowSpacing="5"
              ColumnSpacing="5"
              Padding="15"
              BackgroundColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=PageBackgroundColor}">

            <!-- Заголовок -->
            <Label Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="4"
                   Text="Программа расчета кривой депрессии земляной плотины"
                   HorizontalOptions="Center" VerticalOptions="Center"
                   FontSize="16" FontAttributes="Bold"
                   TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>

            <!-- Кнопка переключения темы -->
            <Button Grid.Row="0" Grid.Column="3"
                    Text="{Binding Source={x:Static local:ThemeManager.Instance}, Path=ThemeButtonText}"
                    BackgroundColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=ThemeButtonColor}"
                    TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"
                    BorderColor="Black" BorderWidth="1" FontAttributes="Bold" CornerRadius="10"
                    HorizontalOptions="End" VerticalOptions="Center"
                    WidthRequest="120" HeightRequest="30"
                    Clicked="OnThemeToggleClicked"/>

            <!-- Подзаголовок -->
            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="4"
                   Text="Введите исходные данные"
                   HorizontalOptions="Center" VerticalOptions="Center"
                   FontSize="16" FontAttributes="Bold"
                   TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>

            <!-- Поля ввода -->
            <controls:NumericEntryStepper Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3"
                                           LabelText="Глубина воды, Н1"
                                           Value="{Binding H1, Mode=TwoWay}"
                                           Minimum="0.1" Maximum="100" Increment="0.1"/>

            <controls:NumericEntryStepper Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3"
                                           LabelText="Заложение верхового откоса, m1"
                                           Value="{Binding M1, Mode=TwoWay}"
                                           Minimum="0.1" Maximum="100" Increment="0.1"/>

            <controls:NumericEntryStepper Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="3"
                                           LabelText="Длина плотины от уреза нормального подпорного уровня, L"
                                           Value="{Binding L, Mode=TwoWay}"
                                           Minimum="0.1" Maximum="100" Increment="0.1"/>

            <controls:NumericEntryStepper Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="3"
                                           LabelText="Коэффициент фильтрации грунта тела плотины, Kt"
                                           Value="{Binding Kt, Mode=TwoWay}"
                                           Minimum="0.01" Maximum="100" Increment="0.1"/>

            <!-- Схема плотины с кривой депрессии -->
            <controls:DamCurveCanvasView Grid.Row="3" Grid.Column="3" Grid.RowSpan="4"
                                          H1="{Binding DrawH1}"
                                          M1="{Binding DrawM1}"
                                          L="{Binding DrawL}"
                                          CurvePoints="{Binding CurvePoints}"
                                          HeightRequest="400"
                                          WidthRequest="800"/>

            <controls:DamCurveCanvasView x:Name="DamCanvas"
                                          Grid.Row="3" Grid.Column="3" Grid.RowSpan="4"
                                          H1="{Binding DrawH1}"
                                          M1="{Binding DrawM1}"
                                          L="{Binding DrawL}"
                                          CurvePoints="{Binding CurvePoints}"
                                          TablePoints="{Binding TablePoints}"
                                          SelectedIndex="{Binding SelectedPointIndex}"
                                          HeightRequest="400"
                                          WidthRequest="800"/>

            <!-- Пустая строка для расстояния -->
            <BoxView Grid.Row="7" Grid.Column="0" Grid.ColumnSpan="4" HeightRequest="20" Color="Transparent"/>

            <!-- Надпись "результаты расчета" -->
            <Label Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="4"
                   Text="Результаты расчета"
                   HorizontalOptions="Center" VerticalOptions="Center"
                   FontSize="16" FontAttributes="Bold"
                   TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>

            <!-- Строка с результатами -->
            <Grid Grid.Row="9" Grid.Column="0" Grid.ColumnSpan="4"
                  ColumnDefinitions="*,*,*,*,*"
                  ColumnSpacing="10"
                  HeightRequest="30">

                <Border Grid.Column="0" BackgroundColor="#9880e5" Stroke="Black" StrokeShape="RoundRectangle 5" Padding="5">
                    <Label Text="{Binding BetaValue, StringFormat='β = {0:F2}'}" HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>
                </Border>
                <Border Grid.Column="1" BackgroundColor="#9880e5" Stroke="Black" StrokeShape="RoundRectangle 5" Padding="5">
                    <Label Text="{Binding DeltaLbValue, StringFormat='ΔLb = {0:F2} м'}" HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>
                </Border>
                <Border Grid.Column="2" BackgroundColor="#9880e5" Stroke="Black" StrokeShape="RoundRectangle 5" Padding="5">
                    <Label Text="{Binding DeltaLpValue, StringFormat='ΔLp = {0:F2} м'}" HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>
                </Border>
                <Border Grid.Column="3" BackgroundColor="#9880e5" Stroke="Black" StrokeShape="RoundRectangle 5" Padding="5">
                    <Label Text="{Binding QValue, StringFormat='q = {0:F2} м/сут'}" HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>
                </Border>
                <Border Grid.Column="4" BackgroundColor="#9880e5" Stroke="Black" StrokeShape="RoundRectangle 5" Padding="5">
                    <Label Text="{Binding LdValue, StringFormat='Lδ = {0:F2} м'}" HorizontalOptions="Center" VerticalOptions="Center"
                           TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>
                </Border>
            </Grid>

            <!-- Таблица 8x2 -->
            <Border Grid.Row="10" Grid.Column="0" Grid.ColumnSpan="4"
                    BackgroundColor="black" Stroke="Black" StrokeShape="RoundRectangle 10"
                    Padding="0">
                <Grid RowDefinitions="33,33"
                      ColumnDefinitions="140,140,140,140,140,140,140,140"
                      RowSpacing="1" ColumnSpacing="1">

                    <Label Grid.Row="0" Grid.Column="0" Text="X, м" FontSize="20"
                           BackgroundColor="#9880e5" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>
                    <Label Grid.Row="0" Grid.Column="1" Text="{Binding TableHeaders[0]}"
                           BackgroundColor="{Binding TableCellColors[0]}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>
                    <Label Grid.Row="0" Grid.Column="2" Text="{Binding TableHeaders[1]}"
                           BackgroundColor="{Binding TableCellColors[1]}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>
                    <Label Grid.Row="0" Grid.Column="3" Text="{Binding TableHeaders[2]}"
                           BackgroundColor="{Binding TableCellColors[2]}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>
                    <Label Grid.Row="0" Grid.Column="4" Text="{Binding TableHeaders[3]}"
                           BackgroundColor="{Binding TableCellColors[3]}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>
                    <Label Grid.Row="0" Grid.Column="5" Text="{Binding TableHeaders[4]}"
                           BackgroundColor="{Binding TableCellColors[4]}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>
                    <Label Grid.Row="0" Grid.Column="6" Text="{Binding TableHeaders[5]}"
                           BackgroundColor="{Binding TableCellColors[5]}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>
                    <Label Grid.Row="0" Grid.Column="7" Text="{Binding TableHeaders[6]}"
                           BackgroundColor="{Binding TableCellColors[6]}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>

                    <Label Grid.Row="1" Grid.Column="0" Text="hₓ, v" FontSize="20"
                           BackgroundColor="#9880e5" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>
                    <Label Grid.Row="1" Grid.Column="1" Text="{Binding TableData[0]}"
                           BackgroundColor="{Binding TableCellColors[0]}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>
                    <Label Grid.Row="1" Grid.Column="2" Text="{Binding TableData[1]}"
                           BackgroundColor="{Binding TableCellColors[1]}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>
                    <Label Grid.Row="1" Grid.Column="3" Text="{Binding TableData[2]}"
                           BackgroundColor="{Binding TableCellColors[2]}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>
                    <Label Grid.Row="1" Grid.Column="4" Text="{Binding TableData[3]}"
                           BackgroundColor="{Binding TableCellColors[3]}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>
                    <Label Grid.Row="1" Grid.Column="5" Text="{Binding TableData[4]}"
                           BackgroundColor="{Binding TableCellColors[4]}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>
                    <Label Grid.Row="1" Grid.Column="6" Text="{Binding TableData[5]}"
                           BackgroundColor="{Binding TableCellColors[5]}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>
                    <Label Grid.Row="1" Grid.Column="7" Text="{Binding TableData[6]}"
                           BackgroundColor="{Binding TableCellColors[6]}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center"
                           TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"/>
                </Grid>
            </Border>

            <!-- Сообщение об ошибке валидации -->
            <Label Grid.Row="11" Grid.Column="0" Grid.ColumnSpan="4"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding HasError}"
                   TextColor="Red"
                   FontAttributes="Bold"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"/>

            <!-- Кнопка Продолжить -->
            <Button x:Name="CalculateButton"
                    Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="8"
                    Text="Продолжить"
                    Command="{Binding CalculateCommand}"
                    BackgroundColor="#9880e5"
                    TextColor="{Binding Source={x:Static local:ThemeManager.Instance}, Path=TextColor}"
                    BorderWidth="1" BorderColor="Black"
                    FontAttributes="Bold" CornerRadius="10"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    WidthRequest="150" HeightRequest="40"
                    Pressed="OnButtonPressed"
                    Released="OnButtonReleased"/>

        </Grid>
    </ScrollView>
</ContentPage>